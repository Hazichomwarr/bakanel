DATABASE_URL=

# Required before production indexing is enabled. Must be the verified public HTTPS origin only,
# without credentials, path, query, or fragment (for example: https://www.example.org).
SITE_URL=

# Optional. Name of the request header that your trusted reverse proxy sets to the client IP (for example
# x-real-ip, or x-forwarded-for behind exactly one appending proxy). Leave empty when no trusted proxy
# overwrites it: forwarding headers are then ignored and only the per-account login throttle applies.
ADMIN_CLIENT_IP_HEADER=

# Integration tests only (pnpm test:integration). Must point at a disposable local PostgreSQL
# database named exactly bakanel_test (localhost, 127.0.0.1, or ::1). Never use a Neon URL here.
TEST_DATABASE_URL="postgresql://USER@localhost:5432/bakanel_test"
